# ─────────────────────────────────────────────────────────────
# Environment variables for the Yahya Khan portfolio.
#
# Copy this file to `.env.local` for local development and set the
# same variables in your Vercel project (Settings → Environment
# Variables). NEVER commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase project URL — the ROOT url only.
# Correct:  https://xxxxxxxxxxxx.supabase.co
# WRONG:    https://xxxxxxxxxxxx.supabase.co/rest/v1/  (a path/suffix breaks it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose to the browser). Used for the
# public site's reads.
# Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (SECRET — server only, never sent to the browser).
# Used for ALL admin writes and file uploads, so it MUST be the real key.
# Supabase Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL the site is deployed at (no trailing slash).
# Used for SEO metadata, sitemap, robots, and OG images.
# Local:      http://localhost:3000
# Production:  https://yahya98.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin login (password checkpoint) ──────────────────────────
# The password you type at /login. Server-only — never exposed to the browser.
ADMIN_PASSWORD=choose-a-strong-password

# A long random string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=generate-a-long-random-secret
